# Configuración local de ejemplo.
# Copiá este archivo como .env (no se versiona) y completá tus valores.

# Conexión a PostgreSQL (Supabase). Usar la cadena del "Session pooler"
# (panel de Supabase → Connect). Incluye la contraseña: nunca la subas al repositorio.
# El servidor se verifica con el certificado raíz de Supabase (certs/supabase-ca.crt).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Puerto del servidor (por defecto 3000)
# PORT=3000
