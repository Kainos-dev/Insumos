# Configuración local de ejemplo.
# Copiá este archivo como .env (no se versiona) y completá tus valores.

# Ruta al archivo SQLite de trabajo. Si no se define, se usa ./calzado.db
# Si se define y el archivo no existe, el servidor no arranca (evita crear una base vacía).
# DB_PATH=C:\ruta\fuera\del\repositorio\calzado.db

# Puerto del servidor (por defecto 3000)
# PORT=3000
